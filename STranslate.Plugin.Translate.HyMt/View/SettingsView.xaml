<UserControl
    x:Class="STranslate.Plugin.Translate.HyMt.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plugin="clr-namespace:STranslate.Plugin;assembly=STranslate.Plugin"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.Plugin.Translate.HyMt.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ikw:SimpleStackPanel Spacing="12">
        <ui:SettingsCard Description="HY-MT API Key（翻译与术语库共用）" Header="{DynamicResource STranslate_Plugin_Translate_HyMt_ApiKey}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Key_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <PasswordBox
                MinWidth="300"
                plugin:PasswordBoxAssistant.Attach="True"
                plugin:PasswordBoxAssistant.Password="{Binding ApiKey}"
                ui:ControlHelper.PlaceholderText="{DynamicResource STranslate_Plugin_Translate_HyMt_ApiKey_Placeholder}" />
        </ui:SettingsCard>

        <ui:SettingsCard Header="腾讯云术语库管理凭证" Description="保存云端术语库需要 SecretId、SecretKey；翻译请求仍使用 HY-MT API Key。">
            <StackPanel>
                <TextBox Text="{Binding SecretId, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.PlaceholderText="SecretId" />
                <PasswordBox Margin="0,6,0,0" plugin:PasswordBoxAssistant.Attach="True" plugin:PasswordBoxAssistant.Password="{Binding SecretKey}" ui:ControlHelper.PlaceholderText="SecretKey" />
                <TextBox Margin="0,6,0,0" Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.PlaceholderText="地域，例如 ap-guangzhou" />
            </StackPanel>
        </ui:SettingsCard>

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Translate_HyMt_Model}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon FontFamily="{StaticResource {x:Static ui:ThemeKeys.FluentSystemIconsKey}}" Glyph="&#xF0797;" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox
                MinWidth="200"
                IsEditable="True"
                ItemsSource="{Binding Models}"
                SelectedItem="{Binding Model, Mode=TwoWay}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding AddModelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Text}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding}" />
                            <Button
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                Padding="4"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                CommandParameter="{Binding}">
                                <ui:FontIcon
                                    FontSize="{DynamicResource STControlFontSize12}"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Icon="{x:Static ui:FluentSystemIcons.Delete_24_Regular}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </ui:SettingsCard>

        <ui:SettingsExpander Header="{DynamicResource STranslate_Plugin_Translate_HyMt_Domains}">
            <ui:SettingsExpander.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TooltipQuote_20_Regular}" />
            </ui:SettingsExpander.HeaderIcon>
            <ui:ToggleSwitch
                IsOn="{Binding IsEnableDomains}"
                OffContent="{DynamicResource Off}"
                OnContent="{DynamicResource On}" />

            <ui:SettingsExpander.Items>
                <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Translate_HyMt_Domains_Content}" IsEnabled="{Binding IsEnableDomains}">
                    <TextBox Text="{Binding Domains}" />
                </ui:SettingsCard>
                <ui:SettingsCard>
                    <ui:HyperlinkButton Content="{DynamicResource STranslate_Plugin_Translate_HyMt_Domains_Website}" NavigateUri="https://cloud.tencent.com/document/product/1823/132252#68bea60b03i3z" />
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <ui:SettingsExpander Header="风格翻译">
            <ui:SettingsExpander.HeaderIcon><ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Pair_20_Regular}" /></ui:SettingsExpander.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding IsEnableStyle}" OffContent="{DynamicResource Off}" OnContent="{DynamicResource On}" />
            <ui:SettingsExpander.Items>
                <ui:SettingsCard Header="目标风格" IsEnabled="{Binding IsEnableStyle}">
                    <TextBox Text="{Binding Style, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" />
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <ui:SettingsExpander Header="HY-MT 术语库">
            <ui:SettingsExpander.HeaderIcon><ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Pair_20_Regular}" /></ui:SettingsExpander.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding IsEnableGlossary}" OffContent="{DynamicResource Off}" OnContent="{DynamicResource On}" />
            <ui:SettingsExpander.Items>
                <ui:SettingsCard Header="术语库 ID（多个用逗号分隔）" IsEnabled="{Binding IsEnableGlossary}">
                    <DataGrid x:Name="PART_GlossaryGrid" AutoGenerateColumns="False" ItemsSource="{Binding Glossaries}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="名称" Width="*" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="术语库 ID" Width="2*" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:SettingsCard>
                <ui:SettingsCard>
                    <StackPanel>
                        <WrapPanel>
                            <Button Command="{Binding GlossaryExportCommand}" Content="导出术语库" />
                            <Button Command="{Binding GlossaryImportCommand}" Content="导入术语库" />
                            <Button Command="{Binding GlossaryAddCommand}" Content="添加术语库" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Command="{Binding GlossaryDeleteCommand}" CommandParameter="{Binding ElementName=PART_GlossaryGrid, Path=SelectedItems}" Content="删除术语库" />
                        <Button Command="{Binding SaveGlossariesToBackendCommand}" Content="保存到云端" Style="{DynamicResource AccentButtonStyle}" />
                        </WrapPanel>
                        <ui:HyperlinkButton Content="术语库管理文档" NavigateUri="https://cloud.tencent.com/document/product/1823/132887" />
                    </StackPanel>
                </ui:SettingsCard>
                <ui:SettingsCard Header="术语库内容（QwenMT 格式）" IsEnabled="{Binding IsEnableGlossary}" Padding="2">
                    <DataGrid x:Name="PART_GlossaryTermsGrid" AutoGenerateColumns="False" ItemsSource="{Binding GlossaryTerms}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="原始术语" Width="*" Binding="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="目标术语" Width="*" Binding="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:SettingsCard>
                <ui:SettingsCard IsEnabled="{Binding IsEnableGlossary}">
                    <WrapPanel>
                        <Button Command="{Binding GlossaryTermsImportCommand}" Content="导入术语库内容" />
                        <Button Command="{Binding GlossaryTermsExportCommand}" Content="导出术语库内容" />
                        <Button Command="{Binding GlossaryTermAddCommand}" Content="添加内容" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Command="{Binding GlossaryTermDeleteCommand}" CommandParameter="{Binding ElementName=PART_GlossaryTermsGrid, Path=SelectedItems}" Content="删除选中内容" />
                    </WrapPanel>
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <ui:SettingsExpander Header="{DynamicResource STranslate_Plugin_Translate_HyMt_Terms}">
            <ui:SettingsExpander.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Pair_20_Regular}" />
            </ui:SettingsExpander.HeaderIcon>

            <ui:ToggleSwitch
                IsOn="{Binding IsEnableTerms}"
                OffContent="{DynamicResource Off}"
                OnContent="{DynamicResource On}" />

            <ui:SettingsExpander.Items>
                <ui:SettingsCard Padding="2" IsEnabled="{Binding IsEnableTerms}">
                    <ui:SettingsCard.Header>
                        <WrapPanel Orientation="Horizontal">
                            <Button
                                Command="{Binding TermsExportCommand}"
                                Content="{DynamicResource STranslate_Plugin_Translate_HyMt_Terms_Export}"
                                IsEnabled="{Binding IsEnableTerms}" />
                            <Button
                                Command="{Binding TermsImportCommand}"
                                Content="{DynamicResource STranslate_Plugin_Translate_HyMt_Terms_Import}"
                                IsEnabled="{Binding IsEnableTerms}" />
                            <Button
                                Margin="20,0,0,0"
                                Command="{Binding TermsClearCommand}"
                                Content="{DynamicResource STranslate_Plugin_Translate_HyMt_Terms_Clear}"
                                IsEnabled="{Binding IsEnableTerms}" />
                        </WrapPanel>
                    </ui:SettingsCard.Header>
                </ui:SettingsCard>
                <ui:SettingsCard Padding="2" IsEnabled="{Binding IsEnableTerms}">
                    <ui:SettingsCard.Header>
                        <DataGrid
                            x:Name="PART_DataGrid"
                            AutoGenerateColumns="False"
                            ItemsSource="{Binding Terms}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding SourceText}"
                                    Header="{DynamicResource STranslate_Plugin_Translate_HyMt_Term_Source}" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding TargetText}"
                                    Header="{DynamicResource STranslate_Plugin_Translate_HyMt_Term_Target}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:SettingsCard.Header>
                </ui:SettingsCard>
                <ui:SettingsCard Padding="2" IsEnabled="{Binding IsEnableTerms}">
                    <ui:SettingsCard.Header>
                        <WrapPanel Orientation="Horizontal">
                            <Button
                                Command="{Binding TermsAddCommand}"
                                Content="{DynamicResource STranslate_Plugin_Translate_HyMt_Term_Add}"
                                Style="{DynamicResource AccentButtonStyle}" />
                            <Button
                                Command="{Binding TermsDeleteCommand}"
                                CommandParameter="{Binding ElementName=PART_DataGrid, Path=SelectedItems}"
                                Content="{DynamicResource STranslate_Plugin_Translate_HyMt_Term_Delete}" />
                        </WrapPanel>
                    </ui:SettingsCard.Header>
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Translate_HyMt_Support}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PersonSupport_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:HyperlinkButton NavigateUri="https://cloud.tencent.com/document/product/1823/132252">
                <TextBlock
                    Text="https://cloud.tencent.com/document/product/1823/132252"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="https://cloud.tencent.com/document/product/1823/132252" />
            </ui:HyperlinkButton>
        </ui:SettingsCard>
    </ikw:SimpleStackPanel>
</UserControl>
